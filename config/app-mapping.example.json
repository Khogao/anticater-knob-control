{
  "global": {
    "rotate_left": {
      "type": "key",
      "description": "Volume down",
      "keys": ["volume_down"]
    },
    "rotate_right": {
      "type": "key",
      "description": "Volume up",
      "keys": ["volume_up"]
    },
    "press": {
      "type": "key",
      "description": "Play / Pause",
      "keys": ["play_pause"]
    },
    "press_rotate_left": {
      "type": "shortcut",
      "description": "Previous media item",
      "keys": ["previous_track"]
    },
    "press_rotate_right": {
      "type": "shortcut",
      "description": "Next media item",
      "keys": ["next_track"]
    }
  },
  "apps": {
    "com.apple.Terminal": {
      "rotate_left": {
        "type": "shortcut",
        "description": "Previous command in history",
        "keys": ["up"]
      },
      "rotate_right": {
        "type": "shortcut",
        "description": "Next command in history",
        "keys": ["down"]
      },
      "press": {
        "type": "shortcut",
        "description": "Return",
        "keys": ["return"]
      },
      "press_rotate_left": {
        "type": "shortcut",
